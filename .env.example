# .env.example — kopieren nach .env und Werte eintragen.
# ADMIN_TOKEN und SECRET_KEY sind immer Pflicht (app.py bricht sonst ab).
# ACCESS_TOKEN ist nur Pflicht, wenn PUBLIC_MODE nicht auf 1 steht.

# PUBLIC_MODE=1 macht die Galerie/Karte fuer alle ohne Token-Link erreichbar
# (z.B. wenn die App nur im eigenen LAN/VPN laeuft). ACCESS_TOKEN entfaellt dann.
PUBLIC_MODE=0

ACCESS_TOKEN=dein-geheimes-passwort
ADMIN_TOKEN=admin-upload-passwort
# Generieren z.B. mit: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

PHOTO_DIR=./photos
THUMB_DIR=./data/thumbs
DB_PATH=./data/trips.db
CONTACT_EMAIL=deine.email@beispiel.de
MAPTILER_API_KEY=
FLASK_DEBUG=0
